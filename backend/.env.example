# Copy this file to .env in the backend folder. Never put real keys in this example file.
# NEVER send .env, or any key in it, in chat, email, or a screenshot.
PAYMENT_MODE=sandbox
PORT=5001
MEAL_PRICE_PKR=250
# JazzCash sandbox (from https://sandbox.jazzcash.com.pk, Generate Credentials)
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=http://localhost:5001/api/payments/jazzcash/return
# Easypaisa Easypay sandbox (issued with your merchant account)
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ACCOUNT_NUMBER=
